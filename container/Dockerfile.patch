# Fast rebuild after changing external/syclops: reinstall only the syclops package
# on top of an existing full image (container/Dockerfile), no Blender download.
#
#   docker build -f container/Dockerfile.patch -t syclops-pipeline:latest .
#
# The full Dockerfile and the cluster build install the same sources, so this is only
# a shortcut for local iterations.
ARG BASE_IMAGE=syclops-pipeline:latest
FROM ${BASE_IMAGE}
COPY external/syclops /tmp/syclops
RUN rm -rf /tmp/syclops/.git \
 && /opt/syclops-venv/bin/pip install --no-cache-dir --no-deps --force-reinstall /tmp/syclops \
 && rm -rf /tmp/syclops \
 && /opt/blender-3.6.1/3.6/python/bin/python3.10 -c "import sys; sys.path.append('/opt/syclops-venv/lib/python3.10/site-packages'); import pkg_resources; pkg_resources.require('syclops'); print('syclops entry points:', sorted(e.name for g in ('syclops.plugins','syclops.postprocessing') for e in pkg_resources.iter_entry_points(g)))"
