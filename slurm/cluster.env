# Cluster settings, sourced by slurm/submit.sh. Edit to match your account.
REPO=/home/iqbal/syclops-pipeline                       # this repo on the cluster
IMAGE=/netscratch/naeem/syclops-pipeline.sqsh           # built by container/build_cluster_image.sh
ASSET_ROOTS=/netscratch/naeem/blender_assets            # colon-separated, mounted at the same path
OUT_ROOT=/netscratch/naeem/syclops_runs                 # runs go to $OUT_ROOT/<job>_<timestamp>/
MOUNTS=/netscratch/naeem:/netscratch/naeem,/home/iqbal/syclops-pipeline:/home/iqbal/syclops-pipeline

PARTITION=RTX3090          # RTXA6000, A100, H100, ... (comma-separated list is allowed by Slurm)
CPUS_PER_GPU=10
MEM=60000                  # MB
TIME=24:00:00              # per shard; ~1 min/frame at 1024px/256spp on a laptop 2080, much less on A100/H100
MAX_PARALLEL=16            # max simultaneously running array tasks (%N)
MAIL_USER=naeem.iqbal@dfki.de
MAIL_TYPE=END,FAIL
